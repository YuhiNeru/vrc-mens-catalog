# CLIのみ。ブラウザへ渡さない。Node --env-file またはPowerShell環境変数で設定。
CATALOG_API_URL=https://vrc-mens-catalog.YOUR-SUBDOMAIN.workers.dev
CATALOG_ADMIN_TOKEN=REPLACE_WITH_RANDOM_32_OR_MORE_CHARACTERS
CRAWL_INTERVAL_MS=3000
CRAWL_MAX_REQUESTS=30
CRAWL_CONCURRENCY=1
CRAWL_REFRESH_DAYS=7
# Worker用 .dev.vars / wrangler secret put ADMIN_TOKEN に同じトークンを設定。

# VPS operations (scripts/vps-collector.ps1, sync-vps.ps1, rollback-vps.ps1). All required; set real values only in your own environment.
VPS_SSH_TARGET=<VPS_USER>@<VPS_HOST>
VPS_SSH_KEY=<PATH_TO_SSH_PRIVATE_KEY>
VPS_KNOWN_HOSTS=<PATH_TO_VERIFIED_KNOWN_HOSTS>
VPS_SERVICE_USER=<COLLECTOR_SERVICE_USER>
VPS_APP_DIR=<COLLECTOR_PROGRAM_DIR>
VPS_STATE_DIR=<COLLECTOR_DATA_DIR>
